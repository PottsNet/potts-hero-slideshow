$t = static fn (string $text): string => I18N::translate($text);

$select = static function (string $name, string $label, array $choices, string $selected, string $help = ''): void {
    ?>
    <div class="potts-hero-field">
        <label class="form-label" for="potts-hero-<?= e($name) ?>"><?= e($label) ?></label>
        <select class="form-select" id="potts-hero-<?= e($name) ?>" name="<?= e($name) ?>">
            <?php foreach ($choices as $value => $choice) : ?>
                <option value="<?= e($value) ?>" <?= $selected === $value ? 'selected' : '' ?>><?= e($choice) ?></option>
            <?php endforeach ?>
        </select>
        <?php if ($help !== '') : ?>
            <div class="form-text"><?= e($help) ?></div>
        <?php endif ?>
    </div>
    <?php
};

$text = static function (string $name, string $label, string $value, string $help = ''): void {
    ?>
    <div class="potts-hero-field">
        <label class="form-label" for="potts-hero-<?= e($name) ?>"><?= e($label) ?></label>
        <input class="form-control" id="potts-hero-<?= e($name) ?>" name="<?= e($name) ?>" value="<?= e($value) ?>">
        <?php if ($help !== '') : ?>
            <div class="form-text"><?= e($help) ?></div>
        <?php endif ?>
    </div>
    <?php
};

$toggle = static function (string $name, string $label, bool $checked, string $help = ''): void {
    ?>
    <label class="potts-hero-toggle" for="potts-hero-<?= e($name) ?>">
        <span>
            <strong><?= e($label) ?></strong>
            <?php if ($help !== '') : ?>
                <small><?= e($help) ?></small>
            <?php endif ?>
        </span>
        <span class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="potts-hero-<?= e($name) ?>" name="<?= e($name) ?>" value="1" <?= $checked ? 'checked' : '' ?>>
        </span>
    </label>
    <?php
};

$enabled_slides = array_values(array_filter($slides, static fn (array $slide): bool => $slide['enabled'] === '1'));
